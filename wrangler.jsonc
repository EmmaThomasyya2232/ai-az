{
  "name": "azure-ai-manager",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 阶段二: D1 持久层。database_id 无需手动查找填写:
  // - CLI 一键部署: npm run setup (自动创建 D1 并回填 id, 幂等可重复执行)
  // - 线上一键部署: README 顶部 Deploy to Cloudflare 按钮 (自动创建资源并替换 id)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azure-ai-manager",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // 阶段五/六: 定时巡检 (节点探活 / 令牌预热 / 日志清理) 与每日养号打卡 (UTC 04:00 ≈ 北京时间 12:00),
  // 任务内容按 cron 匹配: */5 只跑巡检, 每日 04:00 额外跑一次养号打卡
  // 本地测试: curl "http://localhost:8787/__scheduled?cron=*/5+*+*+*+*"  /  "0+4+*+*+*"
  "triggers": {
    "crons": ["*/5 * * * *", "0 4 * * *"]
  }
}
